        line  last_l  = array.get(mo_lines, array.size(mo_lines) - 1)
        label last_lb = array.get(mo_labels, array.size(mo_labels) - 1)
        
        int start_t = line.get_x1(last_l)
        int target_1615 = timestamp('America/New_York', year(start_t, "America/New_York"), month(start_t, "America/New_York"), dayofmonth(start_t, "America/New_York"), 16, 15, 0)

        if time <= target_1615
            line.set_x2(last_l, time)
            if not na(last_lb)
                label.set_x(last_lb, time)
        else
            line.set_x2(last_l, target_1615)
            if not na(last_lb)
                label.set_x(last_lb, target_1615)

    if is_new_day or barstate.islast
        int limit_t = switch disp_mode_mo
            'Last Day'       => start_of_day
            'Current Week'   => cw_time
            'Current Month'  => cm_time
            '20 Days Lookback' => lookback_20_t
            '40 Days Lookback' => lookback_40_t
            '60 Days Lookback' => lookback_60_t
            => 0

        if array.size(mo_lines) > 0
            for i = array.size(mo_lines) - 1 to 0
                line  l_check = array.get(mo_lines, i)
                bool should_delete = line.get_x1(l_check) < limit_t or (disp_mode_mo == 'Last Day' and i < array.size(mo_lines) - 1)
                
                if should_delete
                    line.delete(array.remove(mo_lines, i))
                    label.delete(array.remove(mo_labels, i))

else if not show_mo and array.size(mo_lines) > 0
    for l in mo_lines
        line.delete(l)
    for lb in mo_labels
        label.delete(lb)
    array.clear(mo_lines)
    array.clear(mo_labels)
//==============================================================================
//#endregion
//==============================================================================

//==============================================================================
//#region ✅ SECTION 3: PREVIOUS LEVELS (PDH/PDL/PWH/PWL/PMH/PML)
//=============================================================================
grp_pxl = 'PREVIOUS HIGH/LOW LEVELS (PXH/PXL)'
show_pxl = input.bool(true, 'Show PXH/PXL', group = grp_pxl)

s_pxl    = input.string('Solid', 'Line', options = ['Solid', 'Dashed', 'Dotted'], inline = 'style', group = grp_pxl)
c_master = input.color(color.black, '', inline = 'style', group = grp_pxl)
w_pxl    = input.int(1, 'Width', minval = 1, inline = 'style', group = grp_pxl)
px_txt_s = input.string('Tiny', 'Label', options = ['None', 'Tiny', 'Small', 'Normal', 'Large', 'Huge'], inline = 'style', group = grp_pxl)

// --- Variables Data ---
var float d_h = high, var float d_l = low, var int d_ht = time, var int d_lt = time
var float ph_val = na, var float pl_val = na, var int ph_t = na, var int pl_t = na
var line ph_l = na, var line pl_l = na, var label ph_lb = na, var label pl_lb = na
var bool ph_brk = false, var bool pl_brk = false

var float w_h = high, var float w_l = low, var int w_ht = time, var int w_lt = time
var float pwh_val = na, var float pwl_val = na, var int pwh_t = na, var int pwl_t = na
var line pwh_l = na, var line pwl_l = na, var label pwh_lb = na, var label pwl_lb = na
var bool pwh_brk = false, var bool pwl_brk = false
var bool pwh_drawn = false, var bool pwl_drawn = false // ตัวแปรสถานะป้องกันการแอบสร้างซ้ำกลางสัปดาห์

var float m_h = high, var float m_l = low, var int m_ht = time, var int m_lt = time
var float pmh_val = na, var float pml_val = na, var int pmh_t = na, var int pml_t = na
var line pmh_l = na, var line pml_l = na, var label pmh_lb = na, var label pml_lb = na
var bool pmh_brk = false, var bool pml_brk = false
var bool pmh_drawn = false, var bool pml_drawn = false // ตัวแปรสถานะป้องกันการแอบสร้างซ้ำกลางเดือน

// --- Logic Calculation ---
if is_new_day
    ph_val := d_h, pl_val := d_l
    ph_t := d_ht, pl_t := d_lt
    d_h := high, d_l := low
    d_ht := time, d_lt := time
    ph_brk := false, pl_brk := false
    line.delete(ph_l), line.delete(pl_l), label.delete(ph_lb), label.delete(pl_lb)
    ph_l := na, pl_l := na, ph_lb := na, pl_lb := na
else
    d_h := math.max(high, d_h), d_l := math.min(low, d_l)
    if high == d_h
        d_ht := time
    if low == d_l
        d_lt := time

if is_new_week
    pwh_val := w_h, pwl_val := w_l
    pwh_t := w_ht, pwl_t := w_lt
    w_h := high, w_l := low
    w_ht := time, w_lt := time
    pwh_brk := false, pwl_brk := false
    pwh_drawn := false, pwl_drawn := false // รีเซ็ตสถานะเมื่อขึ้นสัปดาห์ใหม่
    line.delete(pwh_l), line.delete(pwl_l), label.delete(pwh_lb), label.delete(pwl_lb)
    pwh_l := na, pwl_l := na, pwh_lb := na, pwl_lb := na
else
    w_h := math.max(high, w_h), w_l := math.min(low, w_l)
    if high == w_h
        w_ht := time
    if low == w_l
        w_lt := time

if is_new_month
    pmh_val := m_h, pml_val := m_l
    pmh_t := m_ht, pml_t := m_lt
    m_h := high, m_l := low
    m_ht := time, m_lt := time
    pmh_brk := false, pml_brk := false
    pmh_drawn := false, pml_drawn := false // รีเซ็ตสถานะเมื่อขึ้นเดือนใหม่
    line.delete(pmh_l), line.delete(pml_l), label.delete(pmh_lb), label.delete(pml_lb)
    pmh_l := na, pml_l := na, pmh_lb := na, pml_lb := na
else
    m_h := math.max(high, m_h), m_l := math.min(low, m_l)
    if high == m_h
        m_ht := time
    if low == m_l
        m_lt := time


if show_pxl
    // ==========================================
    // 1. Daily Levels (Master สำหรับรวบชื่อ)
    // ==========================================

    // --- PDH (High) ---
    if not na(ph_val)
        if na(ph_l)
            ph_l  := line.new(ph_t, ph_val, time, ph_val, xloc=xloc.bar_time, color=c_master, width=w_pxl, style=get_style(s_pxl))
            ph_lb := label.new(time, ph_val, "", xloc=xloc.bar_time, style=label.style_label_left, color=#ffffff00, textcolor=c_master, size=get_label_size(px_txt_s))
        
        if not ph_brk
            line.set_x2(ph_l, time), label.set_x(ph_lb, time)
            
            string _txt = "PDH"
            if ph_val == pwh_val and not pwh_brk 
                _txt += " + PWH"
                pwh_drawn := true // ล็อกไว้เลยว่า Daily เอาชื่อไปใช้แล้ว ห้าม Weekly วาดซ้ำ
            if ph_val == pmh_val and not pmh_brk 
                _txt += " + PMH"
                pmh_drawn := true // ล็อกไว้เลยว่า Daily เอาชื่อไปใช้แล้ว ห้าม Monthly วาดซ้ำ
            
            label.set_text(ph_lb, _txt)
            if high >= ph_val 
                ph_brk := true

    // --- PDL (Low) ---
    if not na(pl_val)
        if na(pl_l)
            pl_l  := line.new(pl_t, pl_val, time, pl_val, xloc=xloc.bar_time, color=c_master, width=w_pxl, style=get_style(s_pxl))
            pl_lb := label.new(time, pl_val, "", xloc=xloc.bar_time, style=label.style_label_left, color=#ffffff00, textcolor=c_master, size=get_label_size(px_txt_s))
        
        if not pl_brk
            line.set_x2(pl_l, time), label.set_x(pl_lb, time)
            
            string _txt = "PDL"
            if pl_val == pwl_val and not pwl_brk 
                _txt += " + PWL"
                pwl_drawn := true // ล็อกไว้เลยว่า Daily เอาชื่อไปใช้แล้ว ห้าม Weekly วาดซ้ำ
            if pl_val == pml_val and not pml_brk 
                _txt += " + PML"
                pml_drawn := true // ล็อกไว้เลยว่า Daily เอาชื่อไปใช้แล้ว ห้าม Monthly วาดซ้ำ
                
            label.set_text(pl_lb, _txt)
            if low <= pl_val 
                pl_brk := true


    // ==========================================
    // 2. Weekly Levels
    // ==========================================

    // Check ซ้ำกับ Daily หรือไม่
    bool _dup_pwh = (pwh_val == ph_val and not ph_brk) or pwh_drawn
    bool _dup_pwl = (pwl_val == pl_val and not pl_brk) or pwl_drawn

    // ถ้าตรวจเจอว่าซ้ำ หรือโดนรวบชื่อไปแล้ว ให้ทำลายวัตถุของตัวมันเองทิ้งทันที
    if _dup_pwh
        line.delete(pwh_l), label.delete(pwh_lb), pwh_l := na, pwh_lb := na
    if _dup_pwl
        line.delete(pwl_l), label.delete(pwl_lb), pwl_l := na, pwl_lb := na

    // --- PWH ---
    if not na(pwh_val) and not _dup_pwh
        if na(pwh_l)
            pwh_l  := line.new(pwh_t, pwh_val, time, pwh_val, xloc=xloc.bar_time, color=c_master, width=w_pxl, style=get_style(s_pxl))
            pwh_lb := label.new(time, pwh_val, "", xloc=xloc.bar_time, style=label.style_label_left, color=#ffffff00, textcolor=c_master, size=get_label_size(px_txt_s))

        if not pwh_brk
            line.set_x2(pwh_l, time), label.set_x(pwh_lb, time)
            
            string _txt = "PWH"
            if pwh_val == pmh_val and not pmh_brk 
                _txt += " + PMH"
                pmh_drawn := true // ถ้า Weekly รวบเอา Monthly ไปแล้ว ก็ให้ล็อก Monthly ไว้ด้วย
            
            label.set_text(pwh_lb, _txt)
            if high >= pwh_val 
                pwh_brk := true

    // --- PWL ---
    if not na(pwl_val) and not _dup_pwl
        if na(pwl_l)
            pwl_l  := line.new(pwl_t, pwl_val, time, pwl_val, xloc=xloc.bar_time, color=c_master, width=w_pxl, style=get_style(s_pxl))
            pwl_lb := label.new(time, pwl_val, "", xloc=xloc.bar_time, style=label.style_label_left, color=#ffffff00, textcolor=c_master, size=get_label_size(px_txt_s))

        if not pwl_brk
            line.set_x2(pwl_l, time), label.set_x(pwl_lb, time)
            
            string _txt = "PWL"
            if pwl_val == pml_val and not pml_brk 
                _txt += " + PML"
                pml_drawn := true // ถ้า Weekly รวบเอา Monthly ไปแล้ว ก็ให้ล็อก Monthly ไว้ด้วย
                
            label.set_text(pwl_lb, _txt)
            if low <= pwl_val 
                pwl_brk := true


    // ==========================================
    // 3. Monthly Levels
    // ==========================================

    // Check ซ้ำกับ Daily หรือ Weekly หรือไม่
    bool _dup_pmh = (pmh_val == ph_val and not ph_brk) or (pmh_val == pwh_val and not pwh_brk) or pmh_drawn
    bool _dup_pml = (pml_val == pl_val and not pl_brk) or (pml_val == pwl_val and not pwl_brk) or pml_drawn

    // ถ้าซ้ำกับรุ่นพี่ -> ให้ลบวัตถุของ Monthly ทิ้งไปเลย ไม่ต้องวาด
    if _dup_pmh
        line.delete(pmh_l), label.delete(pmh_lb), pmh_l := na, pmh_lb := na
    if _dup_pml
        line.delete(pml_l), label.delete(pml_lb), pml_l := na, pml_lb := na

    // --- PMH ---
    if not na(pmh_val) and not _dup_pmh
        if na(pmh_l)
            pmh_l  := line.new(pmh_t, pmh_val, time, pmh_val, xloc=xloc.bar_time, color=c_master, width=w_pxl, style=get_style(s_pxl))
            pmh_lb := label.new(time, pmh_val, "PMH", xloc=xloc.bar_time, style=label.style_label_left, color=#ffffff00, textcolor=c_master, size=get_label_size(px_txt_s))

        if not pmh_brk
            line.set_x2(pmh_l, time), label.set_x(pmh_lb, time)
            if high >= pmh_val
                pmh_brk := true

    // --- PML ---
    if not na(pml_val) and not _dup_pml
        if na(pml_l)
            pml_l  := line.new(pml_t, pml_val, time, pml_val, xloc=xloc.bar_time, color=c_master, width=w_pxl, style=get_style(s_pxl))
            pml_lb := label.new(time, pml_val, "PML", xloc=xloc.bar_time, style=label.style_label_left, color=#ffffff00, textcolor=c_master, size=get_label_size(px_txt_s))

        if not pml_brk
            line.set_x2(pml_l, time), label.set_x(pml_lb, time)
            if low <= pml_val 
                pml_brk := true

else
    // ถ้าปิดปุ่ม Enable ให้ทำลาย Object ทั้งหมดทิ้งทันที หน้าจอจะได้ไม่ค้างเส้นเก่า
    line.delete(ph_l), line.delete(pl_l), label.delete(ph_lb), label.delete(pl_lb)
    line.delete(pwh_l), line.delete(pwl_l), label.delete(pwh_lb), label.delete(pwl_lb)
    line.delete(pmh_l), line.delete(pml_l), label.delete(pmh_lb), label.delete(pml_lb)
    ph_l := na, pl_l := na, ph_lb := na, pl_lb := na
    pwh_l := na, pwl_l := na, pwh_lb := na, pwl_lb := na
    pmh_l := na, pml_l := na, pmh_lb := na, pml_lb := na
//=============================================================================
//#endregion
//=============================================================================

///==============================================================================
//#region ✅ SECTION 4: NEW DAY/WEEK OPENING GAP (NXOG)
//=============================================================================
grp_nx = 'NEW DAY/WEEK OPENING GAP (NXOG)'
show_nxog = input.bool(true, 'Show NXOG |', inline = '1st', group = grp_nx)
show_ticks_nx = input.bool(true, 'Range |', inline='1st', group=grp_nx, tooltip = "Range is visible only when C.E. Label is active")
disp_mode_nx = input.string('60 Days Lookback', 'Display Limit', options = ['Last Day', 'Current Week', 'Current Month', '20 Days Lookback', '40 Days Lookback', '60 Days Lookback'], inline = '1st', group = grp_nx)

nxog_stop = input.bool(true, 'Stop After Fill', inline = 'main', group = grp_nx)
nxog_delete = input.bool(false, 'Delete After Fill', inline = 'main', group = grp_nx, tooltip = "Filled logic is based on 4h close")

c_bull = input.color(color.rgb(8, 153, 129), 'Bullish', inline='nx_col', group=grp_nx)
c_bear = input.color(color.rgb(242, 54, 69), 'Bearish', inline='nx_col', group=grp_nx)
w_og = input.int(1, 'Width', minval = 1, inline = 'nx_col', group = grp_nx)
og_trans_val = input.int(95, 'Fill %', minval = 0, maxval = 100, inline = 'nx_col', group = grp_nx)

s_og = input.string('Dotted', 'High/Low', options = ['None', 'Solid', 'Dashed', 'Dotted'], inline = 'nx_hl', group = grp_nx)
nx_lbl_sz = input.string('None', 'Label', options = ['None', 'Tiny', 'Small', 'Normal', 'Large'], inline = 'nx_hl', group = grp_nx)
c_og_hl = input.color(color.new(color.black, 75), 'Color', inline = 'nx_hl', group = grp_nx)
nx_ce_style = input.string('Dotted', 'C.E.', options = ['None', 'Solid', 'Dashed', 'Dotted'], inline = 'nx_ce', group = grp_nx)
nx_ce_sz = input.string('None', 'Label', options = ['None', 'Tiny', 'Small', 'Normal', 'Large'], inline = 'nx_ce', group = grp_nx)
c_nx_ce = input.color(color.new(color.black, 75), 'Color', inline = 'nx_ce', group = grp_nx)
nx_q_style = input.string('Dotted', 'Quadrants', options = ['None', 'Solid', 'Dashed', 'Dotted'], inline = 'nx_q', group = grp_nx)
nx_q_sz = input.string('None', 'Label', options = ['None', 'Tiny', 'Small', 'Normal', 'Large'], inline = 'nx_q', group = grp_nx)
c_nx_q = input.color(color.new(color.black, 75), 'Color', inline = 'nx_q', group = grp_nx)

f_update_gap_color(gap_data g, color bull_c, color bear_c, int trans) =>
    color target_color = na
    if g.is_bull
        target_color := g.is_inversion ? bear_c : bull_c
    else
        target_color := g.is_inversion ? bull_c : bear_c
    linefill.set_color(g.l_fill, color.new(target_color, trans))

var ndog_gaps = array.new<gap_data>(0)
var nwog_gaps = array.new<gap_data>(0)

var int[] ndog_day_id = array.new_int(0)
var int[] nwog_day_id = array.new_int(0)

// ✅ แก้ไขแก้ไขการดึงข้อมูล 4H ป้องกันการดึงค่าอนาคต (Lookahead) 
float tf_4h_close = request.security(syminfo.tickerid, "240", close, barmerge.gaps_off, barmerge.lookahead_off)
bool is_new_4h = ta.change(time("240")) != 0

if show_nxog
    limit_reset_nx = switch disp_mode_nx
        'Last Day'      => is_new_day
        'Current Week'  => is_new_week
        'Current Month' => is_new_month
        => false

    if limit_reset_nx
        if array.size(ndog_gaps) > 0
            for g in ndog_gaps
                cleanup_gap(g)
            array.clear(ndog_gaps)
        if array.size(nwog_gaps) > 0
            for g in nwog_gaps
                cleanup_gap(g)
            array.clear(nwog_gaps)
        array.clear(ndog_day_id)
        array.clear(nwog_day_id)

    if is_new_day
        max_days_nx = switch disp_mode_nx
            '20 Days Lookback' => 20
            '40 Days Lookback' => 40
            '60 Days Lookback' => 60
            => 0

        if max_days_nx > 0 and array.size(ndog_day_id) > 0
            for i = array.size(ndog_day_id) - 1 to 0
                if (day_count - array.get(ndog_day_id, i)) >= max_days_nx
                    if array.size(ndog_gaps) > i
                        cleanup_gap(array.get(ndog_gaps, i))
                        array.remove(ndog_gaps, i)
                    array.remove(ndog_day_id, i)

        if max_days_nx > 0 and array.size(nwog_day_id) > 0
            for i = array.size(nwog_day_id) - 1 to 0
                if (day_count - array.get(nwog_day_id, i)) >= max_days_nx
                    if array.size(nwog_gaps) > i
                        cleanup_gap(array.get(nwog_gaps, i))
                        array.remove(nwog_gaps, i)
                    array.remove(nwog_day_id, i)

    if is_new_4h
        if array.size(ndog_gaps) > 0
            for i = array.size(ndog_gaps) - 1 to 0
                g = array.get(ndog_gaps, i)
                if not g.filled
                    if g.is_bull
                        if not g.is_inversion
                            if tf_4h_close <= g.l
                                g.is_inversion := true
                                f_update_gap_color(g, c_bull, c_bear, og_trans_val)
                        else
                            if tf_4h_close >= g.h
                                g.filled := true
                    else
                        if not g.is_inversion
                            if tf_4h_close >= g.h
                                g.is_inversion := true
                                f_update_gap_color(g, c_bull, c_bear, og_trans_val)
                        else
                            if tf_4h_close <= g.l
                                g.filled := true
                    
                    if g.filled
                        if nxog_delete
                            cleanup_gap(g)
                            array.remove(ndog_gaps, i)
                            // ✅ ดึงออกพร้อมกันทันทีเพื่อป้องกันดรรชนี Index คลาดเคลื่อน
                            array.remove(ndog_day_id, i) 
                            continue

        if array.size(nwog_gaps) > 0
            for i = array.size(nwog_gaps) - 1 to 0
                g = array.get(nwog_gaps, i)
                if not g.filled
                    if g.is_bull
                        if not g.is_inversion
                            if tf_4h_close <= g.l
                                g.is_inversion := true
                                f_update_gap_color(g, c_bull, c_bear, og_trans_val)
                        else
                            if tf_4h_close >= g.h
                                g.filled := true
                    else
                        if not g.is_inversion
                            if tf_4h_close >= g.h
                                g.is_inversion := true
                                f_update_gap_color(g, c_bull, c_bear, og_trans_val)
                        else
                            if tf_4h_close <= g.l
                                g.filled := true
                    
                    if g.filled
                        if nxog_delete
                            cleanup_gap(g)
                            array.remove(nwog_gaps, i)
                            // ✅ ดึงออกพร้อมกันทันทีเพื่อป้องกันดรรชนี Index คลาดเคลื่อน
                            array.remove(nwog_day_id, i)
                            continue

    if is_new_day
        if is_new_week and open != close[1]
            color init_c = open > close[1] ? c_bull : c_bear
            gap_data new_nwog = f_render_gap(close[1], open, time, 'NWOG', init_c, init_c, og_trans_val, s_og, c_og_hl, nx_lbl_sz, nx_ce_style, c_nx_ce, nx_ce_sz, nx_q_style, c_nx_q, nx_q_sz, w_og, show_ticks_nx, true)
            array.push(nwog_gaps, new_nwog)
            array.push(nwog_day_id, day_count)
            
        // 2. สร้าง NDOG (เช็คก่อนว่ามี Gap จริงไหม)
        else if not is_new_week and open != close[1]
            color init_c = open > close[1] ? c_bull : c_bear
            gap_data new_ndog = f_render_gap(close[1], open, time, 'NDOG', init_c, init_c, og_trans_val, s_og, c_og_hl, nx_lbl_sz, nx_ce_style, c_nx_ce, nx_ce_sz, nx_q_style, c_nx_q, nx_q_sz, w_og, show_ticks_nx, false)
            array.push(ndog_gaps, new_ndog)
            array.push(ndog_day_id, day_count)

    // ✅ ปรับปรุงระบบการอัปเดตพิกัดเส้นให้มีประสิทธิภาพสูงขึ้น ไม่โหลดกราฟหนักจนเกินไป
    if array.size(nwog_gaps) > 0
