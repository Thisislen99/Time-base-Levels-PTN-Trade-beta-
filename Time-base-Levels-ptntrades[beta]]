                if not na(g.lb_lo)
                    label.set_x(g.lb_lo, time)
                if not na(g.l_mid)
                    line.set_x2(g.l_mid, time)
                if not na(g.lb_mid)
                    label.set_x(g.lb_mid, time)
                if not na(g.l_q25)
                    line.set_x2(g.l_q25, time)
                    line.set_x2(g.l_q75, time)
                if not na(g.lb_q25)
                    label.set_x(g.lb_q25, time)
                if not na(g.lb_q75)
                    label.set_x(g.lb_q75, time)

    if array.size(ndog_gaps) > 0
        for i = array.size(ndog_gaps) - 1 to 0
            g = array.get(ndog_gaps, i)
            if not (nxog_stop and g.filled)
                line.set_x2(g.l_hi, time)
                line.set_x2(g.l_lo, time)
                if not na(g.lb_hi)
                    label.set_x(g.lb_hi, time)
                if not na(g.lb_lo)
                    label.set_x(g.lb_lo, time)
                if not na(g.l_mid)
                    line.set_x2(g.l_mid, time)
                if not na(g.lb_mid)
                    label.set_x(g.lb_mid, time)
                if not na(g.l_q25)
                    line.set_x2(g.l_q25, time)
                    line.set_x2(g.l_q75, time)
                if not na(g.lb_q25)
                    label.set_x(g.lb_q25, time)
                if not na(g.lb_q75)
                    label.set_x(g.lb_q75, time)
else
    if array.size(ndog_gaps) > 0 or array.size(nwog_gaps) > 0
        for g in ndog_gaps
            cleanup_gap(g)
        for g in nwog_gaps
            cleanup_gap(g)
        array.clear(ndog_gaps)
        array.clear(nwog_gaps)
        array.clear(ndog_day_id)
        array.clear(nwog_day_id)
