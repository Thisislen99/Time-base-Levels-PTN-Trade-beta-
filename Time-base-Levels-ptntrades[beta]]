f_render_ipda(int idx, int _time, string _txt, color _col) =>
    if show_ipda_div and not na(_time)
        line  ln = array.get(ipda_lines, idx)
        label lb = array.get(ipda_labels, idx)
        if na(ln)
            ln := line.new(_time, low, _time, high, xloc.bar_time, extend.both, _col, get_style(ses_border), 1)
            lb := label.new(_time, na, _txt, xloc = xloc.bar_time, yloc = yloc.belowbar, color = color.new(color.white, 100), textcolor = _col, style= label.style_label_up, size = get_label_size(ses_txt_size))
            array.set(ipda_lines, idx, ln)
            array.set(ipda_labels, idx, lb)
        else
            line.set_x1(ln, _time)
            line.set_x2(ln, _time)
            label.set_x(lb, _time)

reset_session_objects() =>
    for b in session_boxes
        box.delete(b)
    for lb in session_labels
        label.delete(lb)
    array.clear(session_boxes)
    array.clear(session_labels)
    array.clear(box_day_id)

process_session(int idx, bool en, string ti, string nm, color cl, int tr, string style_border, string txt_sz, string tz, bool show_hl, string ext_style) =>
    is_allowed_tf = timeframe.isintraday and timeframe.multiplier <= 60
    
    bool within_lookback = false

    int start_of_day   = timestamp(year, month, dayofmonth, 0, 0)
    int day_offset     = dayofweek == 1 ? 6 : dayofweek - 2 
    int start_of_week  = start_of_day - (day_offset * 24 * 60 * 60 * 1000)
    int start_of_month = timestamp(year, month, 1, 0, 0)

    if disp_mode_ses == 'Last Day'
        within_lookback := time >= start_of_day
    else if disp_mode_ses == 'Current Week'
        within_lookback := time >= start_of_week
    else if disp_mode_ses == 'Current Month'
        within_lookback := time >= start_of_month
    else
        within_lookback := true

    if en and is_allowed_tf and within_lookback
        session_data s = array.get(session_states, idx)
        int in_s       = time(timeframe.period, ti, tz)
        bool is_start  = not na(in_s) and na(in_s[1])
        bool is_inside = not na(in_s)
        bool is_end    = na(in_s) and not na(in_s[1])

        if is_start
            s.h := high, s.lw := low
            s.ht := time, s.lt := time
            s.hi_hit := false, s.lo_hit := false
            color b_color = style_border == 'None' ? na : cl
            s.b := box.new(time, s.h, time, s.lw, xloc=xloc.bar_time, bgcolor = color.new(cl, tr), border_color = b_color, border_style = get_style(style_border))
            array.push(session_boxes, s.b)
            array.push(box_day_id, day_count)
            label lb = txt_sz != 'None' ? label.new(time, s.h, text = nm, xloc=xloc.bar_time, color = #ffffff00, textcolor = cl, style = label.style_label_down, size = get_label_size(txt_sz)) : na
            array.push(session_labels, lb)
            s.l := lb

        if is_inside
            s.h := math.max(s.h, high)
            s.lw := math.min(s.lw, low)
            if high >= s.h 
                s.ht := time
            if low <= s.lw
                s.lt := time
            box.set_top(s.b, s.h)
            box.set_bottom(s.b, s.lw)
            box.set_right(s.b, time)
            if not na(s.l)
                label.set_xy(s.l, math.round((box.get_left(s.b) + time) / 2), s.h)

        if is_end and show_hl and ext_style != 'None'
            s.l_hi := line.new(s.ht, s.h, time, s.h, xloc = xloc.bar_time, color = cl, style = get_style(ext_style))
            s.l_lo := line.new(s.lt, s.lw, time, s.lw, xloc = xloc.bar_time, color = cl, style = get_style(ext_style))
            array.push(session_lines, s.l_hi)
            array.push(session_lines, s.l_lo)

        if show_hl and not is_inside
            if not na(s.l_hi) and not s.hi_hit
                line.set_x2(s.l_hi, time)
                if high >= s.h
                    s.hi_hit := true
            if not na(s.l_lo) and not s.lo_hit
                line.set_x2(s.l_lo, time)
                if low <= s.lw
                    s.lo_hit := true

if show_ses

    if barstate.islast and show_ipda_div
        f_render_ipda(0, lookback_60_t, "IPDA 60", master_ipda_col)
        f_render_ipda(1, lookback_40_t, "IPDA 40", master_ipda_col)
        f_render_ipda(2, lookback_20_t, "IPDA 20", master_ipda_col)
        f_render_ipda(3, cw_time, "WEEK",  master_ipda_col)
