// 3. Gap Rendering & Cleanup
cleanup_gap(gap_data g) =>
    if not na(g)
        line.delete(g.l_hi)
        line.delete(g.l_lo)
        line.delete(g.l_mid)
        line.delete(g.l_q25)
        line.delete(g.l_q75)
        linefill.delete(g.l_fill)
        label.delete(g.lb_hi)
        label.delete(g.lb_lo)
        label.delete(g.lb_mid)
        label.delete(g.lb_q25)
        label.delete(g.lb_q75)

f_render_gap(float p1, float p2, int start_t, string pref, color bull_c, color bear_c, int trans, string hls, color hlc, string hlz, string ces, color cec, string cez, string qs, color qc, string qz, int w, bool show_range, bool is_w) =>
    float hi   = math.max(p1, p2)
    float lo   = math.min(p1, p2)
    float diff = math.abs(p1 - p2)
    bool is_bull = p2 > p1
    float mid = math.avg(hi, lo)
    
    float pips_val = diff / syminfo.mintick
    string range_txt = show_range ? " (" + str.tostring(pips_val, "#") + ")" : ""
    
    color m_c = is_bull ? bull_c : bear_c
    
    float price_upper = hi - (diff * 0.25) 
    float price_lower = hi - (diff * 0.75)   
    string txt_hi    = is_bull ? " Open" : " Close"
    string txt_lo    = is_bull ? " Close"  : " Open" 
    string label_upper = is_bull ? " 25%" : " 75%"
    string label_lower = is_bull ? " 75%" : " 25%"
    
    g = gap_data.new()
    g.h := hi
    g.l := lo
    g.is_bull := is_bull
    g.is_weekly := is_w
    g.is_inversion := false
    g.start_time := start_t

    color l_c_hl = hls == 'None' ? na : hlc
    g.l_hi := line.new(start_t, hi, time, hi, xloc.bar_time, color=l_c_hl, width=w, style=get_style(hls))
    g.l_lo := line.new(start_t, lo, time, lo, xloc.bar_time, color=l_c_hl, width=w, style=get_style(hls))
    g.l_fill := linefill.new(g.l_hi, g.l_lo, color.new(m_c, trans))

    color l_c_ce = ces == 'None' ? na : cec
    g.l_mid := line.new(start_t, mid, time, mid, xloc.bar_time, color=l_c_ce, width=w, style=get_style(ces))

    color l_c_q = qs == 'None' ? na : qc
    g.l_q25 := line.new(start_t, price_upper, time, price_upper, xloc.bar_time, color=l_c_q, width=w, style=get_style(qs))
    g.l_q75 := line.new(start_t, price_lower, time, price_lower, xloc.bar_time, color=l_c_q, width=w, style=get_style(qs))
    
    if hlz != 'None'
        g.lb_hi := label.new(time, hi, pref + txt_hi, xloc.bar_time, style=label.style_label_left, color=#ffffff00, textcolor=hlc, size=get_label_size(hlz))
        g.lb_lo := label.new(time, lo, pref + txt_lo, xloc.bar_time, style=label.style_label_left, color=#ffffff00, textcolor=hlc, size=get_label_size(hlz))
    
    if cez != 'None'
        g.lb_mid := label.new(time, mid, pref + ' 50%' + range_txt, xloc.bar_time, style=label.style_label_left, color=#ffffff00, textcolor=cec, size=get_label_size(cez))
    
    if qz != 'None'
        g.lb_q25 := label.new(time, price_upper, pref + label_upper, xloc.bar_time, style=label.style_label_left, color=#ffffff00, textcolor=qc, size=get_label_size(qz))
        g.lb_q75 := label.new(time, price_lower, pref + label_lower, xloc.bar_time, style=label.style_label_left, color=#ffffff00, textcolor=qc, size=get_label_size(qz))
    g

