// 1. Helper
get_style(str) =>
    switch str
        'Solid'  => line.style_solid
        'Dotted' => line.style_dotted
        'Dashed' => line.style_dashed
        => line.style_dotted

get_label_size(size_str) =>
    switch size_str
        'Tiny'   => size.tiny
        'Small'  => size.small
        'Normal' => size.normal
        'Large'  => size.large
        'Huge'   => size.huge
        => size.tiny

get_table_size(size_opt) =>
    switch size_opt
        'Tiny'   => size.tiny
        'Small'  => size.small
        'Normal' => size.normal
        'Large'  => size.large
        'Huge'   => size.huge
        => size.normal

// ฟังก์ชันแปลงข้อเลือกตำแหน่งให้เป็น Position ของระบบ Pine Script
get_table_pos(v_pos, h_pos) =>
    if v_pos == 'top'
        h_pos == 'left' ? position.top_left : h_pos == 'right' ? position.top_right : position.top_center
    else if v_pos == 'middle'
        h_pos == 'left' ? position.middle_left : h_pos == 'right' ? position.middle_right : position.middle_center
    else
        h_pos == 'left' ? position.bottom_left : h_pos == 'right' ? position.bottom_right : position.bottom_center

