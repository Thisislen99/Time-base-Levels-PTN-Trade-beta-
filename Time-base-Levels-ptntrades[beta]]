    limit_reset = switch disp_mode_ses
        'Last Day'      => is_new_day or is_ny_1800
        'Current Week'  => is_new_week
        'Current Month' => is_new_month
        => false
    
    if limit_reset
        reset_session_objects()

    if is_new_day or is_ny_1800
        for l in session_lines
            line.delete(l)
        array.clear(session_lines)
        
        max_days = switch disp_mode_ses
            '20 Days Lookback' => 20
            '40 Days Lookback' => 40
            '60 Days Lookback' => 60
            => 999
        if array.size(box_day_id) > 0
            while array.size(box_day_id) > 0 and (day_count - array.get(box_day_id, 0)) > max_days
