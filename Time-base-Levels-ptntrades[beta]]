                label.delete(array.remove(session_labels, 0))
                array.remove(box_day_id, 0)

    process_session(0, s1_on, s1_t, s1_n, s1_c, bg_transp, ses_border, ses_txt_size, tz_string, s1_hl, ext_l_style_in)
    process_session(1, s2_on, s2_t, s2_n, s2_c, bg_transp, ses_border, ses_txt_size, tz_string, s2_hl, ext_l_style_in)
    process_session(2, s3_on, s3_t, s3_n, s3_c, bg_transp, ses_border, ses_txt_size, tz_string, s3_hl, ext_l_style_in)
    process_session(3, s4_on, s4_t, s4_n, s4_c, bg_transp, ses_border, ses_txt_size, tz_string, s4_hl, ext_l_style_in)
    process_session(4, s5_on, s5_t, s5_n, s5_c, bg_transp, ses_border, ses_txt_size, tz_string, s5_hl, ext_l_style_in)
    process_session(5, s6_on, s6_t, s6_n, s6_c, bg_transp, ses_border, ses_txt_size, tz_string, s6_hl, ext_l_style_in)
    process_session(6, s7_on, s7_t, s7_n, s7_c, bg_transp, ses_border, ses_txt_size, tz_string, s7_hl, ext_l_style_in)
    process_session(7, s8_on, s8_t, s8_n, s8_c, bg_transp, ses_border, ses_txt_size, tz_string, s8_hl, ext_l_style_in)
    process_session(8, s9_on, s9_t, s9_n, s9_c, bg_transp, ses_border, ses_txt_size, tz_string, s9_hl, ext_l_style_in)
    process_session(9, s10_on, s10_t, s10_n, s10_c, bg_transp, ses_border, ses_txt_size, tz_string, s10_hl, ext_l_style_in)

else if not show_ses and (array.size(session_boxes) > 0 or array.size(session_lines) > 0)
    reset_session_objects()
    for l in session_lines
        line.delete(l)
    array.clear(session_lines)
