//#region ✅ SECTION 5: OPENING RANGE GAP (ORG)
//=============================================================================
grp_org = 'OPENING RANGE GAP (ORG)'
show_org = input.bool(true, 'Enable ORG |', inline = '1st', group = grp_org)
show_ticks_org = input.bool(true, 'Range |', inline = '1st', group = grp_org,  tooltip = "Range is visible only when C.E. Label is active")
disp_mode_org = input.string('Current Week', 'Display Limit', options = ['Last Day', 'Current Week', 'Current Month', '20 Days Lookback', '40 Days Lookback', '60 Days Lookback'], inline = '1st', group = grp_org)
org_stop = input.bool(false, 'Stop After Fill', inline = 'org_l', group = grp_org)
org_delete = input.bool(false, 'Delete After Fill', inline = 'org_l', group = grp_org, tooltip = "Filled logic is based on wicking")

c_bull_org = input.color(color.rgb(8, 153, 129), 'Bullish', inline = 'org_col', group = grp_org)
c_bear_org = input.color(color.rgb(242, 54, 69), 'Bearish', inline = 'org_col', group = grp_org)
w_org_line = input.int(1, 'Width', minval = 1, inline = 'org_col', group = grp_org)
org_transp = input.int(90, 'Fill %', minval = 0, maxval = 100, inline = 'org_col', group = grp_org)
s_org_hl = input.string('Dotted', 'High/Low', options = ['None', 'Solid', 'Dashed', 'Dotted'], inline = 'org_hl', group = grp_org)
org_hl_sz = input.string('Tiny', 'Label', options = ['None', 'Tiny', 'Small', 'Normal', 'Large'], inline = 'org_hl', group = grp_org)
c_org_hl_i = input.color(color.new(color.black, 50), 'Color', inline = 'org_hl', group = grp_org)
ce_style = input.string('Dotted', 'C.E.', options = ['None', 'Solid', 'Dashed', 'Dotted'], inline = 'org_ce', group = grp_org)
ce_lbl_sz = input.string('Tiny', 'Label', options = ['None', 'Tiny', 'Small', 'Normal', 'Large'], inline = 'org_ce', group = grp_org)
c_ce_i = input.color(color.new(color.black, 50), 'Color', inline = 'org_ce', group = grp_org)
q_style = input.string('Dotted', 'Quadrants', options = ['None', 'Solid', 'Dashed', 'Dotted'], inline = 'org_q', group = grp_org)
q_lbl_sz = input.string('Tiny', 'Label', options = ['None', 'Tiny', 'Small', 'Normal', 'Large'], inline = 'org_q', group = grp_org)
c_q_i = input.color(color.new(color.black, 50), 'Color', inline = 'org_q', group = grp_org)

var org_gaps = array.new<org_gap_data>(0)
var float org_anchor_price = na

if is_bar_closing_at(16, 15) or is_bar_closing_at(13, 0)
    org_anchor_price := close

if show_org

    if is_new_day
        if disp_mode_org == 'Last Day'
            if array.size(org_gaps) > 0
                for i = array.size(org_gaps) - 1 to 0
                    cleanup_gap(array.get(org_gaps, i).base)
                array.clear(org_gaps)
                
        else if disp_mode_org == 'Current Week' and is_new_week
            if array.size(org_gaps) > 0
                int friday_count = 0  // ตัวนับจำนวนวันศุกร์ที่พบ
                
                for i = array.size(org_gaps) - 1 to 0
                    org_g = array.get(org_gaps, i)
                    bool is_friday = dayofweek(org_g.end_time, 'America/New_York') == 6
                    
                    if not is_friday
                        // 1. ถ้าไม่ใช่วันศุกร์ (จันทร์-พฤหัสบดี) ลบทิ้งทันทีเพื่อความคลีน
                        cleanup_gap(org_g.base)
                        array.remove(org_gaps, i)
                    else
                        // 2. ถ้าเป็นวันศุกร์ ให้บวกตัวนับเพิ่ม
                        friday_count := friday_count + 1
                        // 3. ถ้าเจอวันศุกร์เกิน 3 อันแล้ว (อันที่ 4 เป็นต้นไป) ให้ลบทิ้งให้หมด
                        if friday_count > 3
                            cleanup_gap(org_g.base)
                            array.remove(org_gaps, i)
                        
        else if disp_mode_org == 'Current Month' and is_new_month
            if array.size(org_gaps) > 0
                for i = array.size(org_gaps) - 1 to 0
                    cleanup_gap(array.get(org_gaps, i).base)
                array.clear(org_gaps)

    if is_ny_0930 and not na(org_anchor_price)
        max_days_org = switch disp_mode_org
            '20 Days Lookback' => 20
            '40 Days Lookback' => 40
            '60 Days Lookback' => 60
            => 0
        
        if max_days_org > 0 and array.size(org_gaps) > 0
            if (day_count - array.get(org_gaps, 0).d_id) >= max_days_org
                cleanup_gap(array.get(org_gaps, 0).base), array.remove(org_gaps, 0)

        int session_end_today = timestamp('America/New_York', year, month, dayofmonth, 16, 15, 0)
        gap_data g = f_render_gap(org_anchor_price, open, time, 'ORG', c_bull_org, c_bear_org, org_transp, s_org_hl, c_org_hl_i, org_hl_sz, ce_style, c_ce_i, ce_lbl_sz, q_style, c_q_i, q_lbl_sz, w_org_line, show_ticks_org, false)
        array.push(org_gaps, org_gap_data.new(g, session_end_today, day_count))

    if array.size(org_gaps) > 0
        for i = array.size(org_gaps) - 1 to 0
            org_g = array.get(org_gaps, i)
            g = org_g.base
            
            if not g.filled
                if (g.is_bull and low <= g.l) or (not g.is_bull and high >= g.h)
                    g.filled := true
                    if org_delete
                        cleanup_gap(g), array.remove(org_gaps, i)
                        continue 

            int current_ext = math.min(time, org_g.end_time)
            if not (org_stop and g.filled)
                line.set_x2(g.l_hi, current_ext)
                line.set_x2(g.l_lo, current_ext)
                if not na(g.lb_hi)
                    label.set_x(g.lb_hi, current_ext)
                if not na(g.lb_lo)
                    label.set_x(g.lb_lo, current_ext)
                
                if not na(g.l_mid)
                    line.set_x2(g.l_mid, current_ext)
                    if not na(g.lb_mid)
                        label.set_x(g.lb_mid, current_ext)
                
                if not na(g.l_q25)
                    line.set_x2(g.l_q25, current_ext)
                    line.set_x2(g.l_q75, current_ext)
                    if not na(g.lb_q25)
                        label.set_x(g.lb_q25, current_ext)
                    if not na(g.lb_q75)
                        label.set_x(g.lb_q75, current_ext)
else
    if array.size(org_gaps) > 0
        for og in org_gaps
            cleanup_gap(og.base)
        array.clear(org_gaps)
